% jmlr2e.sty -- 2-equal-author style file for JMLR papers
% This is a faithful reimplementation matching the JMLR formatting guide.
% Based on the publicly available JMLR template (jmlr2e.sty).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jmlr2e}[2026/04/25 v1.0 JMLR 2-equal-author style]

% --- Use Times font ---
\RequirePackage{times}

% --- Page geometry: standard JMLR layout (US letter) ---
\RequirePackage[letterpaper,
    top=1in, bottom=1in, left=1in, right=1in,
    headheight=14pt, headsep=14pt, footskip=24pt]{geometry}

% --- Header / Footer setup ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\thepage}

% --- Heading commands stored for header use ---
\def\jmlrheading#1#2#3#4#5#6{%
  \def\@jmlrvolume{#1}%
  \def\@jmlryear{#2}%
  \def\@jmlrpages{#3}%
  \def\@jmlrsubmitted{#4}%
  \def\@jmlrpublished{#5}%
  \def\@jmlrauthors{#6}%
}

\def\ShortHeadings#1#2{%
  \def\@shorttitle{#1}%
  \def\@shortauthors{#2}%
  \fancypagestyle{rest}{%
    \fancyhf{}%
    \fancyhead[C]{\textsc{\@shortauthors}}%
    \fancyfoot[C]{\thepage}%
  }%
}

\def\firstpageno#1{\setcounter{page}{#1}}

% --- The first page header ---
\def\@firstpagehead{%
  \noindent\textit{Journal of Machine Learning Research \@jmlrvolume\ (\@jmlryear) \@jmlrpages}%
  \hfill
  \textit{Submitted \@jmlrsubmitted; Published \@jmlrpublished}%
  \par\medskip
}

% Provide defaults
\def\@jmlrvolume{0}
\def\@jmlryear{2026}
\def\@jmlrpages{1--6}
\def\@jmlrsubmitted{4/26}
\def\@jmlrpublished{4/26}
\def\@jmlrauthors{Anonymous}
\def\@shorttitle{Short Title}
\def\@shortauthors{Anonymous}

% --- Title and authors ---
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \thispagestyle{empty}%
    \@firstpagehead
    \vspace{18pt}%
    \begin{center}%
      {\Large\bfseries \@title \par}%
    \end{center}%
    \vspace{12pt}%
    \@author
    \par\vspace{6pt}%
    \ifx\@editor\@empty\else
      \noindent\textbf{Editor:} \@editor\par
    \fi
  \endgroup
  \pagestyle{rest}%
}

% Editor command
\def\editor#1{\gdef\@editor{#1}}
\def\@editor{}

% Author block: \author{...} where each author is given as
%   \name Author One \email one@example.com \\
%   \addr Department, University,\\ City, ZIP, Country
\long\def\@author{}
\renewcommand{\author}[1]{\gdef\@author{#1}}

% \name <text> \email <email> \\  -- consumes everything up to the line
% break to render the name in bold on the left and the email right-aligned
% in small caps, matching the JMLR look.
\long\def\name#1\email#2\\{\noindent\textbf{#1}\hfill\textsc{#2}\\}
\def\addr{\noindent\itshape}
\def\AND{\par\vspace{12pt}}

% --- Abstract ---
\renewenvironment{abstract}{%
  \vspace{6pt}%
  \begin{center}\large\bfseries Abstract\end{center}%
  \begingroup
    \leftskip=0.25in \rightskip=0.25in
    \small
}{%
  \endgroup
  \par\vspace{6pt}%
}

% --- Keywords ---
\newcommand{\keywords}[1]{%
  \noindent\hspace*{0.25in}\textbf{Keywords:}\quad #1\par\vspace{6pt}%
}

% --- Section headings ---
\renewcommand\section{\@startsection {section}{1}{\z@}%
                                   {-2.0ex \@plus -0.6ex \@minus -.2ex}%
                                   {1.0ex \@plus.2ex}%
                                   {\normalfont\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
                                     {-1.6ex\@plus -0.5ex \@minus -.2ex}%
                                     {0.6ex \@plus .2ex}%
                                     {\normalfont\normalsize\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
                                        {-1.0ex\@plus -.5ex \@minus -.2ex}%
                                        {0.4ex \@plus .2ex}%
                                        {\normalfont\normalsize\itshape}}

% --- Citation style (natbib, author-year) ---
\RequirePackage[round,authoryear]{natbib}
\bibliographystyle{plainnat}

% Tighter bibliography spacing
\renewcommand{\bibsection}{\section*{References}}
\setlength{\bibsep}{1pt}
\renewcommand{\bibfont}{\footnotesize}

% --- Misc useful packages typically loaded by JMLR template ---
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb,amsthm}

% --- Acknowledgments command (JMLR convention) ---
\newcommand{\acks}[1]{%
  \par\vspace{6pt}%
  \noindent\textbf{Acknowledgments and Disclosure of Funding}\par\vspace{4pt}%
  #1\par
}

% --- First page footer with copyright ---
\def\@firstpagefooter{%
  \vfill
  \noindent
  \textcopyright\@jmlryear\ \@jmlrauthors.\par
  \noindent\footnotesize License: CC-BY 4.0, see \texttt{https://creativecommons.org/licenses/by/4.0/}.
  Attribution requirements are provided at \texttt{http://jmlr.org/papers/}.\par
}

\AtBeginDocument{%
  % nothing extra needed; \maketitle handles the first-page header
}

\AtEndDocument{}

\endinput
